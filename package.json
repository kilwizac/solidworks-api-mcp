{
  "name": "solidworks-mcp",
  "version": "0.1.0",
  "description": "MCP server providing intelligent access to SolidWorks API documentation",
  "type": "module",
  "private": true,
  "bin": {
    "solidworks-mcp": "./bin/solidworks-mcp"
  },
  "scripts": {
    "solidworks-mcp": "bun run server/solidworks_mcp_server.ts",
    "start": "bun run solidworks-mcp",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.2.23"
}
